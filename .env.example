DATABASE_URL=sqlite:///./bookflow.db

LLM_PROVIDER=ollama

# When running locally (uvicorn on host): http://localhost:11434
# When running in Docker (Ollama on host): http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_CTX=8192
# Force Ollama's `format=json` mode. Safer for parsing; some models (aya-expanse) close JSON early.
OLLAMA_FORCE_JSON_FORMAT=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

CORS_ORIGINS=["*"]

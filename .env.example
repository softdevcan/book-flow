DATABASE_URL=sqlite:///./bookflow.db

LLM_PROVIDER=ollama

# Translation pipeline: "single" (one pass) or "two_stage" (Builder -> Artist).
TRANSLATION_PIPELINE=single

# When running locally (uvicorn on host): http://localhost:11434
# When running in Docker (Ollama on host): http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Two-stage models. Leave EMPTY to force per-request selection from the UI
# (no hardcoded default). Set a tag here only if you want a fixed fallback,
# e.g. OLLAMA_STAGE1_MODEL=qwen3.5:9b — but it must be an installed model.
OLLAMA_STAGE1_MODEL=
OLLAMA_STAGE2_MODEL=
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_CTX=8192
# Reasoning toggle for reasoning models (qwen3.x etc.). false = direct answer,
# faster and avoids reasoning eating the token budget. Translation needs no CoT.
OLLAMA_THINK=false
# Raised for two sequential passes + Ollama model-swap latency (used by both pipelines).
OLLAMA_TIMEOUT_SECONDS=400
# Force Ollama's `format=json` mode. Safer for parsing; some models (aya-expanse) close JSON early.
OLLAMA_FORCE_JSON_FORMAT=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

CORS_ORIGINS=["*"]
